{
  "commands": [
    {"op": "set_owned_cards", "cards": ["PLANT_LILYPAD", "PLANT_THORNLILY", "PLANT_FLOATSUNFLOWER"]},
    {"op": "goto_level", "level": 28, "resetTestState": true},
    {"op": "set_fullscreen", "value": false},
    {"op": "wait_state", "state": "CHOOSE_CARD", "timeout": 30},
    {"op": "wait_value", "path": "chooseCardReady", "equals": true, "timeout": 30},
    {"op": "assert_state", "path": "watersideThirdResourcesReady", "equals": true},
    {"op": "assert_state", "path": "chooseCardVisibleCards", "equals": ["PLANT_LILYPAD", "PLANT_THORNLILY", "PLANT_FLOATSUNFLOWER"]},
    {"op": "screenshot", "name": "choose_cards.png"},
    {"op": "dump_state", "name": "choose_cards.json"},
    {"op": "click", "target": "choose_card", "plantType": "PLANT_LILYPAD", "hold_frames": 3},
    {"op": "wait_frames", "value": 2},
    {"op": "click", "target": "choose_card", "plantType": "PLANT_THORNLILY", "hold_frames": 3},
    {"op": "wait_frames", "value": 2},
    {"op": "click", "target": "choose_card", "plantType": "PLANT_FLOATSUNFLOWER", "hold_frames": 3},
    {"op": "wait_frames", "value": 2},
    {"op": "assert_state", "path": "chooseCardSelectedCards", "equals": ["PLANT_LILYPAD", "PLANT_THORNLILY", "PLANT_FLOATSUNFLOWER"]},
    {"op": "wait_value", "path": "chooseCardSelectedMovingCount", "equals": 0, "timeout": 10},
    {"op": "screenshot", "name": "selected_cards.png"},
    {"op": "choose_cards", "cards": []},
    {"op": "wait_state", "state": "GAME", "timeout": 30},
    {"op": "set_spawn_paused", "value": true},
    {"op": "set_sun", "value": 9999},
    {"op": "plant", "type": "PLANT_LILYPAD", "row": 2, "col": 3},
    {"op": "wait_frames", "value": 3},
    {"op": "assert_state", "path": "cardCount", "equals": 3},
    {"op": "assert_state", "path": "cards.0.type", "equals": "PLANT_LILYPAD"},
    {"op": "assert_state", "path": "cards.1.type", "equals": "PLANT_THORNLILY"},
    {"op": "assert_state", "path": "cards.1.ready", "equals": true},
    {"op": "assert_state", "path": "cards.2.type", "equals": "PLANT_FLOATSUNFLOWER"},
    {"op": "screenshot", "name": "card_slots.png"},
    {"op": "dump_state", "name": "card_slots.json"},
    {"op": "quit"}
  ]
}
