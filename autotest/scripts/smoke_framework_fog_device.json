{
  "commands": [
    {"op": "goto_level", "level": 93, "resetTestState": true},
    {"op": "choose_cards", "cards": ["PLANT_PEASHOOTER"]},
    {"op": "wait_state", "state": "GAME", "timeout": 30},
    {"op": "set_spawn_paused", "value": true},
    {"op": "set_fog_weather", "intensity": "DEFAULT", "duration": 1},
    {"op": "station_control", "device": 1, "value": 4},
    {"op": "set_timescale", "value": 5},
    {"op": "wait_seconds", "value": 9, "timeout": 5},
    {"op": "assert_state", "path": "weatherStation.controls.1.value", "equals": 4},
    {"op": "assert_state", "path": "fog.intensity", "equals": "DENSE"},
    {"op": "assert_state", "path": "fog.remaining", "equals": 1},
    {"op": "assert_state", "path": "fog.forecastReady", "equals": false},
    {"op": "set_timescale", "value": 0},
    {"op": "save_level_snapshot", "name": "device_dense"},
    {"op": "reload_level_snapshot", "name": "device_dense"},
    {"op": "assert_state", "path": "fog.intensity", "equals": "DENSE"},
    {"op": "assert_state", "path": "fog.remaining", "equals": 1},
    {"op": "assert_state", "path": "fog.forecastReady", "equals": false},
    {"op": "assert_state", "path": "fog.effectiveLeftColumn", "equals": 2},
    {"op": "set_timescale", "value": 5},
    {"op": "wait_seconds", "value": 40, "timeout": 12},
    {"op": "assert_state", "path": "fog.intensity", "equals": "DENSE"},
    {"op": "assert_state", "path": "fog.remaining", "equals": 1},
    {"op": "assert_state", "path": "fog.forecastReady", "equals": false},
    {"op": "station_control", "device": 1, "value": 0},
    {"op": "wait_seconds", "value": 10, "timeout": 5},
    {"op": "assert_state", "path": "fog.effectiveLeftColumn", "equals": 9},
    {"op": "assert_state", "path": "fog.visibleCells", "equals": 0},
    {"op": "set_timescale", "value": 0},
    {"op": "save_level_snapshot", "name": "device_off"},
    {"op": "reload_level_snapshot", "name": "device_off"},
    {"op": "assert_state", "path": "weatherStation.controls.1.value", "equals": 0},
    {"op": "assert_state", "path": "fog.visibleCells", "equals": 0},
    {"op": "assert_state", "path": "fog.remaining", "equals": 1},
    {"op": "dump_state", "name": "state.json"},
    {"op": "quit"}
  ]
}
