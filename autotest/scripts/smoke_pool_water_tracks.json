{
  "description": "Native water tracks bypass only the zombie waterline, preserve colors, restore from saves and survive parallel drawing.",
  "commands": [
    {"op": "goto_level", "level": 19, "resetTestState": true},
    {"op": "choose_cards", "cards": []},
    {"op": "wait_state", "state": "GAME", "timeout": 30},
    {"op": "set_spawn_paused", "value": true},
    {"op": "spawn_zombie", "type": "ZOMBIE_POOL_NORMAL", "row": 2, "x": 590, "stationary": true},
    {"op": "spawn_zombie", "type": "ZOMBIE_POOL_CONE", "row": 2, "x": 760, "stationary": true},
    {"op": "spawn_zombie", "type": "ZOMBIE_POOL_BUCKET", "row": 3, "x": 700, "stationary": true},
    {"op": "wait_frames", "value": 3},
    {"op": "set_timescale", "value": 0},
    {"op": "screenshot", "name": "entry_early.png"},
    {"op": "dump_state", "name": "entry_early.json"},
    {"op": "set_timescale", "value": 1},
    {"op": "wait_seconds", "value": 0.4},
    {"op": "set_timescale", "value": 0},
    {"op": "screenshot", "name": "swimming.png"},
    {"op": "dump_state", "name": "swimming.json"},
    {"op": "assert_state", "path": "zombiesByType.ZOMBIE_POOL_NORMAL.waterlineExemptQuads", "equals": 2},
    {"op": "assert_state", "path": "zombiesByType.ZOMBIE_POOL_NORMAL.poolWaterTexturesLoaded", "equals": true},
    {"op": "assert_state", "path": "zombiesByType.ZOMBIE_POOL_CONE.waterlineExemptQuads", "equals": 2},
    {"op": "assert_state", "path": "zombiesByType.ZOMBIE_POOL_CONE.poolWaterTexturesLoaded", "equals": true},
    {"op": "assert_state", "path": "zombiesByType.ZOMBIE_POOL_BUCKET.waterlineExemptQuads", "equals": 2},
    {"op": "assert_state", "path": "zombiesByType.ZOMBIE_POOL_BUCKET.poolWaterTexturesLoaded", "equals": true},
    {"op": "apply_zombie_control", "row": 2, "index": 0, "effect": "SLOW", "duration": 10},
    {"op": "damage_zombie", "type": "ZOMBIE_POOL_NORMAL", "damage": 1, "source": "PLANT"},
    {"op": "screenshot", "name": "slowed_hit.png"},
    {"op": "dump_state", "name": "slowed_hit.json"},
    {"op": "assert_state", "path": "zombiesByType.ZOMBIE_POOL_NORMAL.waterlineExemptQuads", "equals": 2},
    {"op": "save_level_snapshot", "name": "water_ripples"},
    {"op": "reload_level_snapshot", "name": "water_ripples"},
    {"op": "wait_state", "state": "GAME", "timeout": 30},
    {"op": "set_timescale", "value": 0},
    {"op": "screenshot", "name": "restored.png"},
    {"op": "dump_state", "name": "restored.json"},
    {"op": "assert_state", "path": "zombiesByType.ZOMBIE_POOL_NORMAL.waterlineExemptQuads", "equals": 2},
