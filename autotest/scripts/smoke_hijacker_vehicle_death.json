{
  "description": "Shared hijacker execution uses vehicle explosions without requesting anim_death; roof fixture also permits inherited elite variants.",
  "commands": [
    { "op": "goto_level", "level": 49, "resetTestState": true },
    { "op": "choose_cards", "cards": [] },
    { "op": "wait_state", "state": "GAME", "timeout": 30 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_weather", "intensity": "HEAVY", "duration": 90 },
    { "op": "spawn_zombie", "type": "ZOMBIE_HIJACKER", "row": 4, "x": 850, "stationary": true },
    { "op": "spawn_zombie", "type": "ZOMBIE_ZAMBONI", "row": 0, "x": 650, "stationary": true },
    { "op": "spawn_zombie", "type": "ZOMBIE_GILDED_ZAMBONI", "row": 1, "x": 650, "stationary": true },
    { "op": "damage_zombie", "type": "ZOMBIE_GILDED_ZAMBONI", "damage": 400, "source": "OTHER" },
    { "op": "spawn_zombie", "type": "ZOMBIE_CATAPULT", "row": 2, "x": 650, "stationary": true },
    { "op": "spawn_zombie", "type": "ZOMBIE_ELITE_CATAPULT", "row": 3, "x": 650, "stationary": true },
    { "op": "assert_state", "path": "zombieCount", "equals": 5 },
    { "op": "set_night_roof_charge", "phase": "CHARGING", "charge": 74.9 },
    { "op": "trigger_lightning" },
    { "op": "assert_state", "path": "weather.nightRoofCharge.executionLine", "equals": 2000 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_ZAMBONI.hijackerDoomed", "equals": true },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_GILDED_ZAMBONI.hijackerDoomed", "equals": true },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_CATAPULT.hijackerDoomed", "equals": true },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_ELITE_CATAPULT.hijackerDoomed", "equals": true },
    { "op": "trigger_lightning" },
    { "op": "wait_value", "path": "hijackerResources.executeSoundPlayRequests", "equals": 1, "timeout": 15 },
    { "op": "assert_state", "path": "zombieCount", "equals": 1 },
    { "op": "assert_state", "path": "zombiesByType.ZOMBIE_HIJACKER.track", "equals": "anim_death" },
    { "op": "assert_state", "path": "particleEffectNameCounts.ZamboniExplosion", "equals": 1 },
    { "op": "assert_state", "path": "particleEffectNameCounts.GildedZamboniExplosion", "equals": 1 },
    { "op": "assert_state", "path": "particleEffectNameCounts.CatapultExplosion", "equals": 1 },
    { "op": "assert_state", "path": "particleEffectNameCounts.EliteCatapultExplosion", "equals": 1 },
    { "op": "dump_state", "name": "vehicle_execution.json" },
    { "op": "screenshot", "name": "vehicle_execution.png" },
    { "op": "wait_seconds", "value": 4, "timeout": 8 },
    { "op": "assert_state", "path": "zombieCount", "equals": 0 },
    { "op": "quit" }
  ]
}
