{
  "commands": [
    { "op": "goto_level", "level": 10, "resetTestState": true },
    { "op": "choose_cards", "cards": ["PLANT_PEASHOOTER", "PLANT_DOOMSHROOM"] },
    { "op": "set_sun", "value": 9000 },
    { "op": "wait_frames", "value": 80 },
    { "op": "dump_state", "name": "intro_slide_preselect_state.json" },

    { "op": "click", "x": 220, "y": 25, "hold_frames": 2 },
    { "op": "wait_frames", "value": 2 },
    { "op": "move_mouse", "x": 600, "y": 220 },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "boardState", "equals": "CHOOSE_CARD" },
    { "op": "assert_state", "path": "cards.0.selected", "equals": false },
    { "op": "assert_state", "path": "plantPreview", "equals": null },
    { "op": "screenshot", "name": "intro_slide_input_blocked.png" },
    { "op": "click", "x": 900, "y": 100, "button": "right", "hold_frames": 2 },

    { "op": "wait_state", "state": "GAME", "timeout": 15 },
    { "op": "set_spawn_paused", "value": true },
    { "op": "set_sun", "value": 9000 },
    { "op": "plant", "type": "PLANT_DOOMSHROOM", "row": 2, "col": 5 },
    { "op": "wait_seconds", "value": 1.2 },
    { "op": "wait_frames", "value": 20 },
    { "op": "assert_state", "path": "shake.shakeOn", "equals": 1 },

    { "op": "click", "x": 220, "y": 25, "hold_frames": 2 },
    { "op": "wait_frames", "value": 2 },
    { "op": "move_mouse", "x": 600, "y": 220 },
    { "op": "wait_frames", "value": 2 },
    { "op": "key", "name": "space" },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "paused", "equals": true },
    { "op": "assert_state", "path": "shake.shakeOn", "equals": 1 },
    { "op": "assert_state", "path": "cards.0.selected", "equals": true },
    { "op": "assert_state", "path": "plantPreview.renderProbeReady", "equals": true },
    { "op": "assert_state", "path": "plantPreview.renderMouseOffsetXInt", "equals": 0 },
    { "op": "assert_state", "path": "plantPreview.renderMouseOffsetYInt", "equals": 0 },
    { "op": "screenshot", "name": "paused_shake_preview_tracks_mouse.png" },
    { "op": "dump_state", "name": "plant_preview_camera_state.json" },
    { "op": "quit" }
  ]
}
