{
  "description": "Public ice rise permits a legal blind doom cast while fog control is locked; once unlocked, the sparring player buys clear fog normally. No enemy units are present.",
  "commands": [
    {
      "op": "goto_level",
      "level": 96,
      "resetTestState": true
    },
    {
      "op": "choose_cards",
      "cards": [
        "PLANT_DOOMSHROOM"
      ]
    },
    {
      "op": "wait_state",
      "state": "GAME",
      "timeout": 30
    },
    {
      "op": "set_spawn_paused",
      "value": true
    },
    {
      "op": "set_sun",
      "value": 1000
    },
    {
      "op": "set_cold_storage",
      "state": {
        "playerIce": 200,
        "enemyIce": 500,
        "decisionRemaining": 60
      }
    },
    {
      "op": "station_control",
      "device": 1,
      "value": 1,
      "player": false
    },
    {
      "op": "wait_seconds",
      "value": 9,
      "timeout": 20
    },
    {
      "op": "set_cold_storage",
      "state": {
        "supplyRemaining": 1,
        "decisionRemaining": 60
      }
    },
    {
      "op": "dump_state",
      "name": "before_blind.json"
    },
    {
      "op": "commander_episode",
      "opponent": "ice_bunker_mixed",
      "seconds": 3,
      "name": "blind",
      "timeScale": 1
    },
    {
      "op": "dump_state",
      "name": "after_blind.json"
    },
    {
      "op": "assert_state",
      "path": "weatherStation.controls.1.value",
      "equals": 1
    },
    {
      "op": "assert_state",
      "path": "zombieCount",
      "equals": 0
    },
    {
      "op": "wait_seconds",
      "value": 28,
      "timeout": 38
    },
    {
      "op": "dump_state",
      "name": "before_clear.json"
    },
    {
      "op": "commander_episode",
      "opponent": "ice_bunker_mixed",
      "seconds": 1,
      "name": "clear",
      "timeScale": 1
    },
    {
      "op": "dump_state",
      "name": "after_clear.json"
    },
    {
      "op": "assert_state",
      "path": "weatherStation.controls.1.pending",
      "equals": 0
    },
    {
      "op": "assert_state",
      "path": "weatherStation.controls.1.player",
      "equals": true
    },
    {
      "op": "wait_seconds",
      "value": 9,
      "timeout": 20
    },
    {
      "op": "assert_state",
      "path": "weatherStation.controls.1.value",
      "equals": 0
    },
    {
      "op": "quit"
    }
  ]
}
