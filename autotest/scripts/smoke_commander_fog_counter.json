{
  "description": "Paid fog cancellation forecast shares player resources and obeys actual warning/protection; real control exposes a worker to existing fire.",
  "commands": [
    {"op":"goto_level","level":93,"resetTestState":true},
    {"op":"choose_cards","cards":["PLANT_PEASHOOTER"]},
    {"op":"wait_state","state":"GAME","timeout":30},
    {"op":"set_spawn_paused","value":true},
    {"op":"set_sun","value":0},
    {"op":"set_cold_storage","state":{"enemyIce":1000,"playerIce":100,"decisions":10,"decisionRemaining":60}},
    {"op":"station_control","device":1,"value":4},
    {"op":"set_timescale","value":4},
    {"op":"wait_seconds","value":40},
    {"op":"set_timescale","value":1},
    {"op":"plant","type":"PLANT_PEASHOOTER","row":0,"col":0},
    {"op":"plant","type":"PLANT_PEASHOOTER","row":0,"col":1},
    {"op":"plant","type":"PLANT_PEASHOOTER","row":0,"col":2},
    {"op":"plant","type":"PLANT_PEASHOOTER","row":0,"col":3},
    {"op":"spawn_zombie","type":"ZOMBIE_ICE_WORKER","row":0,"x":850,"stationary":true},
    {"op":"set_cold_storage","state":{"enemyIce":0,"playerIce":40,"decisionRemaining":60}},
    {"op":"plan_ice_attack","background":true},
    {"op":"await_ice_attack","timeout":30},
    {"op":"dump_state","name":"fog_counter_forecast.json"},
    {"op":"assert_state","path":"coldStorage.searchFogCounters","equals":1},
    {"op":"assert_state","path":"coldStorage.playerIce","equals":40},
    {"op":"assert_state","path":"weatherStation.controls.1.pending","equals":-1},
    {"op":"station_control","device":1,"value":0},
    {"op":"assert_state","path":"coldStorage.playerIce","equals":0},
    {"op":"wait_seconds","value":7},
    {"op":"assert_state","path":"weatherStation.controls.1.value","equals":4},
    {"op":"assert_state","path":"coldStorage.workerIncome","atLeast":4},
    {"op":"wait_seconds","value":2},
    {"op":"assert_state","path":"weatherStation.controls.1.value","equals":0},
    {"op":"wait_seconds","value":20,"timeout":30},
    {"op":"assert_state","path":"coldStorage.hostileCount","equals":0},
    {"op":"dump_state","name":"fog_counter_actual.json"}
  ]
}
