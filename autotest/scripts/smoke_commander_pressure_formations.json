{
  "description": "Published commander evaluates experienced ranged formations and living-front reinforcements without changing real purchases or policy weights.",
  "commands": [
    {"op":"goto_level","level":95,"resetTestState":true},
    {"op":"choose_cards","cards":["PLANT_WALLNUT","PLANT_PEASHOOTER","PLANT_MELONPULT","PLANT_MENDINGCOTTON"]},
    {"op":"wait_state","state":"GAME","timeout":30},
    {"op":"set_spawn_paused","value":true},
    {"op":"set_sun","value":5000},
    {"op":"set_cold_storage","state":{"enemyIce":240,"initialEnemyIce":240,"playerIce":500,"decisions":20,"decisionRemaining":600}},
    {"op":"plant","type":"PLANT_WALLNUT","row":2,"col":5},
    {"op":"plant","type":"PLANT_MELONPULT","row":2,"col":2},
    {"op":"plant","type":"PLANT_MENDINGCOTTON","row":2,"col":4},
    {"op":"plant","type":"PLANT_WALLNUT","row":1,"col":5},
    {"op":"plant","type":"PLANT_PEASHOOTER","row":1,"col":1},
    {"op":"compare_commander_search","name":"ranged_formations","budgetsMs":[600],"candidatePlans":[
      {"name":"wait","actions":[]},
      {"name":"guarded_shooters","actions":[{"type":"ZOMBIE_BUCKET","row":2},{"type":"ZOMBIE_PRESSURE_SHOOTER","row":2,"count":2,"delay":4}]},
      {"name":"fast_screen","actions":[{"type":"ZOMBIE_FOOTBALL","row":2,"count":2},{"type":"ZOMBIE_PRESSURE_SHOOTER","row":2,"count":2}]}
    ]},
    {"op":"assert_state","path":"coldStorage.spent","equals":0},
    {"op":"spawn_zombie","type":"ZOMBIE_BUCKET","row":2,"x":750,"stationary":true},
    {"op":"wait_seconds","value":0.1},
    {"op":"compare_commander_search","name":"existing_front","budgetsMs":[600],"candidatePlans":[
      {"name":"wait","actions":[]},
      {"name":"shooters_only","actions":[{"type":"ZOMBIE_PRESSURE_SHOOTER","row":2,"count":2}]}
    ]},
    {"op":"assert_state","path":"coldStorage.spent","equals":0},
    {"op":"dump_state","name":"real_wallet_unchanged.json"},
    {"op":"quit"}
  ]
}
