{
  "batchStepsPerFrame": 16,
  "commands": [
    {"op":"reset_test_state"},
    {"op":"commander_experiment","weights":[0,0,0,0,1,0,0,0],"searchVersion":1},
    {"op":"goto_level","level":82},
    {"op":"choose_cards","cards":["PLANT_DAWNLOTUS"]},
    {"op":"wait_state","state":"GAME","timeout":25},
    {"op":"set_spawn_paused","value":true},
    {"op":"plant","type":"PLANT_DAWNLOTUS","row":2,"col":2},
    {"op":"wait_seconds","value":20.2,"timeout":30},
    {"op":"spawn_zombie","type":"ZOMBIE_NORMAL","row":0,"x":900,"stationary":true},
    {"op":"set_cold_storage","state":{"enemyIce":24,"initialEnemyIce":24,"decisions":20,"decisionRemaining":60}},
    {"op":"queue_ice_zombie","type":"ZOMBIE_ICE_WORKER","row":1,"delay":4},
    {"op":"dump_state","name":"before.json"},
    {"op":"plan_ice_attack"},
    {"op":"assert_state","path":"coldStorage.searchRowStrikeCount","equals":1},
    {"op":"assert_state","path":"coldStorage.searchCounterHoldSeconds","atLeast":8},
    {"op":"assert_state","path":"coldStorage.searchRawProduction","atMost":23},
    {"op":"assert_state","path":"coldStorage.pendingCount","equals":1},
    {"op":"assert_state","path":"coldStorage.spent","equals":24},
    {"op":"assert_state","path":"coldStorage.enemyIce","equals":0},
    {"op":"assert_state","path":"normalPlantsByCell.2_2.dawnCanActivate","equals":true},
    {"op":"assert_state","path":"zombiesByType.ZOMBIE_NORMAL.bodyHealth","equals":270},
    {"op":"dump_state","name":"forecast.json"},
    {"op":"set_spawn_paused","value":false},
    {"op":"wait_seconds","value":5,"timeout":10},
    {"op":"set_spawn_paused","value":true},
    {"op":"assert_state","path":"zombiesByType.ZOMBIE_ICE_WORKER.bodyHealth","equals":500},
    {"op":"activate_dawn_lotus","row":2,"col":2},
    {"op":"wait_frames","value":2},
    {"op":"assert_state","path":"zombiesByType.ZOMBIE_ICE_WORKER.bodyHealth","equals":0},
    {"op":"assert_state","path":"zombiesByType.ZOMBIE_NORMAL.bodyHealth","equals":0},
    {"op":"assert_state","path":"normalPlantsByCell.2_2.dawnCanActivate","equals":false},
    {"op":"assert_state","path":"coldStorage.spent","equals":24},
    {"op":"dump_state","name":"actual.json"},
    {"op":"quit"}
  ]
}
