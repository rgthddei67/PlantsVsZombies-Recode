{
  "description": "Gilded Zamboni boost presentation: real speed tiers, reset, pause, load, independent sources and death.",
  "commands": [
    {"op": "goto_level", "level": 1, "resetTestState": true},
    {"op": "choose_cards", "cards": []},
    {"op": "wait_state", "state": "GAME", "timeout": 20},
    {"op": "set_spawn_paused", "value": true},
    {"op": "set_fullscreen", "value": false},
    {"op": "set_timescale", "value": 2},
    {"op": "spawn_zombie", "type": "ZOMBIE_GILDED_ZAMBONI", "row": 2, "x": 1050},
    {"op": "wait_seconds", "value": 5.7, "timeout": 20},
    {"op": "assert_state", "path": "zombies.0.gildedBoostTextureLoaded", "equals": true},
    {"op": "assert_state", "path": "particleEffectNameCounts.GildedZamboniBoost", "equals": 0},
    {"op": "screenshot", "name": "before_boost.png"},
    {"op": "dump_state", "name": "before_boost.json"},
    {"op": "wait_seconds", "value": 0.35, "timeout": 20},
    {"op": "screenshot", "name": "boost_kick.png"},
    {"op": "dump_state", "name": "boost_kick.json"},
    {"op": "assert_state", "path": "zombies.0.gildedAccelerationStage", "equals": 1},
    {"op": "assert_state", "path": "particleEffectNameCounts.GildedZamboniBoost", "atLeast": 1},
    {"op": "assert_state", "path": "particleEffectNameCounts.GildedZamboniBoostKick", "atLeast": 1},
    {"op": "wait_seconds", "value": 0.35, "timeout": 20},
    {"op": "screenshot", "name": "boost_sustained.png"},
    {"op": "dump_state", "name": "boost_sustained.json"},
    {"op": "assert_state", "path": "particleEffectsByName.GildedZamboniBoost.0.renderProbeReady", "equals": true},
    {"op": "assert_state", "path": "particleEffectsByName.GildedZamboniBoost.0.worldBounds.widthInt", "atLeast": 35},
    {"op": "assert_state", "path": "particleEffectsByName.GildedZamboniBoost.0.nearestZombie.centerDxInt", "atLeast": 60, "atMost": 200},
    {"op": "assert_state", "path": "particleEffectsByName.GildedZamboniBoost.0.nearestZombie.centerDyInt", "atLeast": 0, "atMost": 65},
    {"op": "save_level_snapshot", "name": "boost"},
    {"op": "reload_level_snapshot", "name": "boost"},
    {"op": "screenshot", "name": "boost_loaded.png"},
    {"op": "dump_state", "name": "boost_loaded.json"},
    {"op": "assert_state", "path": "particleEffectNameCounts.GildedZamboniBoostKick", "equals": 0},
    {"op": "assert_state", "path": "particleEffectNameCounts.GildedZamboniBoost", "atLeast": 1},
    {"op": "set_timescale", "value": 0},
    {"op": "screenshot", "name": "paused_a.png"},
    {"op": "dump_state", "name": "paused_a.json"},
    {"op": "wait_frames", "value": 15},
    {"op": "screenshot", "name": "paused_b.png"},
    {"op": "dump_state", "name": "paused_b.json"},
    {"op": "set_timescale", "value": 2},
    {"op": "wait_seconds", "value": 3.6, "timeout": 20},
    {"op": "screenshot", "name": "overdrive.png"},
    {"op": "dump_state", "name": "overdrive.json"},
    {"op": "assert_state", "path": "zombies.0.gildedAccelerationStage", "equals": 2},
    {"op": "assert_state", "path": "particleEffectNameCounts.GildedZamboniOverdrive", "atLeast": 1},
    {"op": "wait_seconds", "value": 4.1, "timeout": 20},
    {"op": "screenshot", "name": "capped_boost.png"},
    {"op": "dump_state", "name": "capped_boost.json"},
    {"op": "assert_state", "path": "zombies.0.gildedAccelerationStage", "equals": 3},
    {"op": "assert_state", "path": "zombies.0.gildedAccelerationMultiplierPct", "equals": 800},
    {"op": "assert_state", "path": "particleEffectNameCounts.GildedZamboniBoostKick", "equals": 0},
    {"op": "damage_zombie", "row": 2, "damage": 20, "source": "OTHER"},
    {"op": "wait_seconds", "value": 0.4, "timeout": 20},
    {"op": "screenshot", "name": "damaged_reset.png"},
    {"op": "dump_state", "name": "damaged_reset.json"},
    {"op": "assert_state", "path": "zombies.0.gildedAccelerationStage", "equals": 0},
    {"op": "assert_state", "path": "particleEffectNameCounts.GildedZamboniBoost", "equals": 0},
    {"op": "assert_state", "path": "particleEffectNameCounts.GildedZamboniOverdrive", "equals": 0},
    {"op": "assert_state", "path": "particleEffectNameCounts.GildedZamboniBoostKick", "equals": 0},
    {"op": "goto_level", "level": 1, "resetTestState": true},
    {"op": "choose_cards", "cards": []},
    {"op": "wait_state", "state": "GAME", "timeout": 20},
    {"op": "set_spawn_paused", "value": true},
    {"op": "set_fullscreen", "value": false},
    {"op": "set_timescale", "value": 2},
    {"op": "spawn_zombie", "type": "ZOMBIE_GILDED_ZAMBONI", "row": 1, "x": 1000},
    {"op": "spawn_zombie", "type": "ZOMBIE_GILDED_ZAMBONI", "row": 3, "x": 1000},
    {"op": "wait_seconds", "value": 6.3, "timeout": 20},
    {"op": "damage_zombie", "row": 1, "damage": 20, "source": "OTHER"},
    {"op": "wait_seconds", "value": 0.4, "timeout": 20},
    {"op": "screenshot", "name": "independent_boosts.png"},
    {"op": "dump_state", "name": "independent_boosts.json"},
    {"op": "assert_state", "path": "zombies.0.gildedAccelerationStage", "equals": 0},
    {"op": "assert_state", "path": "zombies.1.gildedAccelerationStage", "equals": 1},
    {"op": "assert_state", "path": "particleEffectNameCounts.GildedZamboniBoost", "atLeast": 1},
    {"op": "damage_zombie", "row": 3, "damage": 5000, "source": "OTHER"},
    {"op": "wait_seconds", "value": 0.4, "timeout": 20},
    {"op": "screenshot", "name": "boost_source_dead.png"},
    {"op": "dump_state", "name": "boost_source_dead.json"},
    {"op": "assert_state", "path": "particleEffectNameCounts.GildedZamboniBoost", "equals": 0},
    {"op": "assert_state", "path": "particleEffectNameCounts.GildedZamboniOverdrive", "equals": 0},
    {"op": "quit"}
  ]
}
