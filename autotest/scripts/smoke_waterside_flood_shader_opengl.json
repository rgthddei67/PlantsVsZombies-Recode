{
  "description": "Water shader and SDF dial visual contract; run with matching renderer arguments.",
  "commands": [
    {"op": "goto_level", "level": 101, "resetTestState": true},
    {"op": "wait_state", "state": "CHOOSE_CARD", "timeout": 30},
    {"op": "set_waterside_water", "value": 28},
    {"op": "wait_seconds", "value": 1},
    {"op": "screenshot", "name": "intro_flood.png"},
    {"op": "wait_seconds", "value": 5},
    {"op": "assert_state", "path": "chooseCardReady", "equals": true},
    {"op": "screenshot", "name": "choose_flood.png"},
    {"op": "choose_cards", "cards": ["PLANT_SUNFLOWER", "PLANT_LILYPAD", "PLANT_FLOWERPOT", "PLANT_WALLNUT"]},
    {"op": "wait_state", "state": "GAME", "timeout": 30},
    {"op": "set_spawn_paused", "value": true},
    {"op": "set_weather", "intensity": "TORRENT", "duration": 600},
    {"op": "set_waterside_water", "value": 25},
    {"op": "wait_seconds", "value": 1},
    {"op": "screenshot", "name": "partial.png"},
    {"op": "wait_seconds", "value": 5},
    {"op": "screenshot", "name": "advancing.png"},
    {"op": "set_waterside_water", "value": 100},
    {"op": "wait_seconds", "value": 1},
    {"op": "screenshot", "name": "full.png"},
    {"op": "dump_state", "name": "full.json"},
    {"op": "goto_level", "level": 100, "resetTestState": true},
    {"op": "choose_cards", "cards": []},
    {"op": "wait_state", "state": "GAME", "timeout": 30},
    {"op": "set_spawn_paused", "value": true},
    {"op": "set_weather", "intensity": "CLEAR", "duration": 600},
    {"op": "wait_seconds", "value": 1},
    {"op": "screenshot", "name": "original_pool.png"},
    {"op": "quit"}
  ]
}
