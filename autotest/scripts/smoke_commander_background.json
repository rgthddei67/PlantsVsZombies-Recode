{
  "commands": [
    {"op": "goto_level", "level": 82, "resetTestState": true},
    {"op": "choose_cards", "cards": ["PLANT_SUNFLOWER", "PLANT_CHERRYBOMB", "PLANT_JALAPENO", "PLANT_SQUASH", "PLANT_MARIGOLD", "PLANT_MELONPULT", "PLANT_WALLNUT"]},
    {"op": "wait_state", "state": "GAME", "timeout": 25},
    {"op": "set_spawn_paused", "value": true},
    {"op": "commander_experiment", "weights": [0, 0, 0, 0, 0, 1, 0, 0]},
    {"op": "set_cold_storage", "state": {"enemyIce": 200, "initialEnemyIce": 200, "decisions": 20, "decisionRemaining": 60}},
    {"op": "queue_ice_zombie", "type": "ZOMBIE_ICE_WORKER", "row": 0, "delay": 40},
    {"op": "plan_ice_attack", "background": true},
    {"op": "assert_state", "path": "coldStorage.planning", "equals": true},
    {"op": "assert_state", "path": "coldStorage.spent", "equals": 24},
    {"op": "dump_state", "name": "started.json"},
    {"op": "await_ice_attack", "timeout": 15},
    {"op": "assert_state", "path": "coldStorage.planningApplied", "equals": 1},
    {"op": "dump_state", "name": "committed.json"},
    {"op": "wait_frames", "value": 5},
    {"op": "await_ice_attack"},
    {"op": "dump_state", "name": "once.json"},
    {"op": "plan_ice_attack", "background": true},
    {"op": "plant", "type": "PLANT_CHERRYBOMB", "row": 2, "col": 7},
    {"op": "await_ice_attack", "timeout": 15},
    {"op": "assert_state", "path": "coldStorage.planningDiscarded", "equals": 1},
    {"op": "dump_state", "name": "stale.json"},
    {"op": "plan_ice_attack", "background": true},
    {"op": "save_level_snapshot", "name": "async_pending"},
    {"op": "reload_level_snapshot", "name": "async_pending"},
    {"op": "wait_state", "state": "GAME", "timeout": 25},
    {"op": "assert_state", "path": "coldStorage.planning", "equals": false},
    {"op": "dump_state", "name": "restored.json"},
    {"op": "plan_ice_attack", "background": true},
    {"op": "goto_level", "level": 83, "resetTestState": true},
    {"op": "choose_cards", "cards": ["PLANT_SUNFLOWER"]},
    {"op": "wait_state", "state": "GAME", "timeout": 25},
    {"op": "assert_state", "path": "coldStorage.spent", "equals": 0},
    {"op": "assert_state", "path": "coldStorage.planning", "equals": false},
    {"op": "dump_state", "name": "new_board.json"},
    {"op": "set_spawn_paused", "value": false},
    {"op": "key", "name": "space"},
    {"op": "wait_frames", "value": 3},
    {"op": "plan_ice_attack", "background": true},
    {"op": "wait_frames", "value": 45},
    {"op": "assert_state", "path": "coldStorage.planning", "equals": true},
    {"op": "assert_state", "path": "coldStorage.spent", "equals": 0},
    {"op": "dump_state", "name": "paused.json"},
    {"op": "key", "name": "space"},
    {"op": "wait_value", "path": "coldStorage.planning", "equals": false, "timeout": 15},
    {"op": "assert_state", "path": "coldStorage.planningApplied", "equals": 1},
    {"op": "dump_state", "name": "resumed.json"},
    {"op": "quit"}
  ]
}
