{
  "description": "Detached zombie parts contact their own lane on flat, sloped and mixed terrain, with separate dry and water outcomes.",
  "commands": [
    {"op":"goto_level","level":1,"resetTestState":true},
    {"op":"choose_cards","cards":[]},
    {"op":"wait_state","state":"GAME","timeout":15},
    {"op":"set_spawn_paused","value":true},
    {"op":"assert_state","path":"rows","equals":5},
    {"op":"spawn_zombie","type":"ZOMBIE_NORMAL","row":4,"x":620,"stationary":true},
    {"op":"damage_zombie","type":"ZOMBIE_NORMAL","row":4,"damage":185},
    {"op":"wait_value","path":"particleEffectsByName.ZombieHeadOff.0.partLandContacts","equals":1,"timeout":3},
    {"op":"screenshot","name":"lawn_head_and_arm.png"},
    {"op":"assert_state","path":"particleEffectsByName.ZombieHeadOff.0.partRow","equals":4},
    {"op":"assert_state","path":"particleEffectsByName.ZombieHeadOff.0.partQuadBottomToSurfaceInt","atLeast":-12,"atMost":16},
    {"op":"assert_state","path":"particleEffectsByName.ZombieArmOff.0.partLandContacts","atLeast":1},
    {"op":"wait_value","path":"particleEffectsByName.ZombieHeadOff.0.partLandContacts","equals":2,"timeout":3},
    {"op":"screenshot","name":"lawn_head_settled.png"},
    {"op":"assert_state","path":"particleEffectsByName.ZombieHeadOff.0.partQuadBottomToSurfaceInt","atLeast":-1,"atMost":16},

    {"op":"goto_level","level":19},
    {"op":"choose_cards","cards":["PLANT_LILYPAD"]},
    {"op":"wait_state","state":"GAME","timeout":15},
    {"op":"set_spawn_paused","value":true},
    {"op":"assert_state","path":"rows","equals":6},
    {"op":"assert_state","path":"poolSplashResources.waterParticlePartsLoaded","equals":true},
    {"op":"spawn_zombie","type":"ZOMBIE_POOL_CONE","row":2,"x":570,"stationary":true},
    {"op":"spawn_zombie","type":"ZOMBIE_POOL_BUCKET","row":3,"x":730,"stationary":true},
    {"op":"spawn_zombie","type":"ZOMBIE_NORMAL","row":5,"x":620,"stationary":true},
    {"op":"damage_zombie","type":"ZOMBIE_POOL_CONE","row":2,"damage":370},
    {"op":"damage_zombie","type":"ZOMBIE_NORMAL","row":5,"damage":185},
    {"op":"wait_value","path":"particleEffectsByName.ZombieConeOff.0.partWaterContacts","equals":1,"timeout":3},
    {"op":"screenshot","name":"pool_cone_contact.png"},
    {"op":"assert_state","path":"particleEffectsByName.ZombiePartSplash.0.activeParticleCount","equals":6},
    {"op":"assert_state","path":"particleEffectsByName.ZombieConeOff.0.partQuadBottomToSurfaceInt","atLeast":1},
    {"op":"wait_seconds","value":0.1},
    {"op":"assert_state","path":"particleEffectsByName.ZombieHeadOff.0.partRow","equals":5},
    {"op":"assert_state","path":"particleEffectsByName.ZombieHeadOff.0.partLandContacts","atLeast":1},
    {"op":"damage_zombie","type":"ZOMBIE_POOL_BUCKET","row":3,"damage":1100},
    {"op":"wait_value","path":"particleEffectsByName.ZombieBucketOff.0.partWaterContacts","equals":1,"timeout":3},
    {"op":"screenshot","name":"pool_bucket_contact.png"},
    {"op":"assert_state","path":"particleEffectsByName.ZombieBucketOff.0.partLandContacts","equals":0},
    {"op":"wait_seconds","value":0.16},
    {"op":"screenshot","name":"pool_bucket_sinking.png"},
    {"op":"assert_state","path":"particleEffectsByName.ZombieBucketOff.0.partQuadBottomToSurfaceInt","atLeast":4},

    {"op":"goto_level","level":45},
    {"op":"choose_cards","cards":["PLANT_FLOWERPOT"]},
    {"op":"wait_state","state":"GAME","timeout":15},
    {"op":"set_spawn_paused","value":true},
    {"op":"spawn_zombie","type":"ZOMBIE_TRAFFIC_CONE","row":2,"x":340,"stationary":true},
    {"op":"spawn_zombie","type":"ZOMBIE_BUCKET","row":2,"x":770,"stationary":true},
    {"op":"damage_zombie","type":"ZOMBIE_TRAFFIC_CONE","row":2,"damage":370},
    {"op":"damage_zombie","type":"ZOMBIE_BUCKET","row":2,"damage":1100},
    {"op":"wait_value","path":"particleEffectsByName.ZombieConeOff.0.partLandContacts","equals":1,"timeout":3},
    {"op":"wait_value","path":"particleEffectsByName.ZombieBucketOff.0.partLandContacts","equals":1,"timeout":3},
    {"op":"wait_seconds","value":0.28},
    {"op":"screenshot","name":"roof_slope_and_flat.png"},
    {"op":"assert_state","path":"particleEffectsByName.ZombieConeOff.0.partQuadBottomToSurfaceInt","atLeast":-3,"atMost":18},
    {"op":"assert_state","path":"particleEffectsByName.ZombieBucketOff.0.partQuadBottomToSurfaceInt","atLeast":-3,"atMost":22},
    {"op":"assert_state","path":"particleEffectsByName.ZombieConeOff.0.partSurfaceFromRowCenterInt","atLeast":48,"atMost":51},

    {"op":"goto_level","level":101},
    {"op":"choose_cards","cards":["PLANT_LILYPAD"]},
    {"op":"wait_state","state":"GAME","timeout":20},
    {"op":"set_spawn_paused","value":true},
    {"op":"set_weather","intensity":"CLEAR","duration":600},
    {"op":"set_waterside_water","value":0},
    {"op":"spawn_zombie","type":"ZOMBIE_POOL_NORMAL","row":2,"x":600,"stationary":true},
    {"op":"spawn_zombie","type":"ZOMBIE_TRAFFIC_CONE","row":2,"x":855,"stationary":true},
    {"op":"damage_zombie","type":"ZOMBIE_POOL_NORMAL","row":2,"damage":185},
    {"op":"damage_zombie","type":"ZOMBIE_TRAFFIC_CONE","row":2,"damage":370},
    {"op":"wait_value","path":"particleEffectsByName.ZombieHeadOff.0.partWaterContacts","equals":1,"timeout":3},
    {"op":"wait_value","path":"particleEffectsByName.ZombieConeOff.0.partLandContacts","equals":1,"timeout":3},
    {"op":"screenshot","name":"waterside_same_lane.png"},
    {"op":"assert_state","path":"particleEffectsByName.ZombieHeadOff.0.partRow","equals":2},
    {"op":"assert_state","path":"particleEffectsByName.ZombieConeOff.0.partRow","equals":2},
    {"op":"assert_state","path":"particleEffectsByName.ZombieConeOff.0.partWaterContacts","equals":0},
    {"op":"quit"}
  ]
}
