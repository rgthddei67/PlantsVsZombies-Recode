{
  "commands": [
    {"op": "goto_level", "level": 61, "resetTestState": true},
    {"op": "choose_cards", "cards": ["PLANT_PEASHOOTER"]},
    {"op": "wait_state", "state": "GAME", "timeout": 30},
    {"op": "set_spawn_paused", "value": true},
    {"op": "set_auto_collect", "value": false},
    {"op": "set_sun", "value": 50},
    {"op": "set_timescale", "value": 0},
    {"op": "save_level_snapshot", "name": "empty"},
    {"op": "reload_level_snapshot", "name": "empty", "patch": [{"op": "add", "path": "/suns", "value": [{"id": 1, "x": 400, "y": 300, "small": false}]}]},
    {"op": "wait_frames", "value": 2},
    {"op": "assert_state", "path": "suns.0.collected", "equals": false},
    {"op": "click", "x": 400, "y": 300},
    {"op": "wait_frames", "value": 2},
    {"op": "assert_state", "path": "suns.0.collected", "equals": true},
    {"op": "save_level_snapshot", "name": "in_flight"},
    {"op": "reload_level_snapshot", "name": "in_flight"},
    {"op": "dump_state", "name": "restored.json"},
    {"op": "assert_state", "path": "suns.0.collected", "equals": true},
    {"op": "assert_state", "path": "sun", "equals": 50},
    {"op": "set_timescale", "value": 1},
    {"op": "wait_value", "path": "sun", "equals": 75, "timeout": 5},
    {"op": "wait_frames", "value": 2},
    {"op": "assert_state", "path": "normalSunCount", "equals": 0},
    {"op": "set_timescale", "value": 0},
    {"op": "reload_level_snapshot", "name": "empty", "patch": [{"op": "add", "path": "/suns", "value": [{"id": 1, "x": 400, "y": 300, "small": true}]}]},
    {"op": "wait_frames", "value": 2},
    {"op": "click", "x": 400, "y": 300},
    {"op": "wait_frames", "value": 2},
    {"op": "assert_state", "path": "suns.0.collected", "equals": true},
    {"op": "save_level_snapshot", "name": "small_in_flight"},
    {"op": "reload_level_snapshot", "name": "small_in_flight"},
    {"op": "assert_state", "path": "suns.0.collected", "equals": true},
    {"op": "assert_state", "path": "smallSunCount", "equals": 1},
    {"op": "set_timescale", "value": 1},
    {"op": "wait_value", "path": "sun", "equals": 65, "timeout": 5},
    {"op": "set_timescale", "value": 0},
    {"op": "save_level_snapshot", "name": "small_credited"},
    {"op": "reload_level_snapshot", "name": "small_credited"},
    {"op": "assert_state", "path": "smallSunCount", "equals": 0},
    {"op": "assert_state", "path": "sun", "equals": 65},
    {"op": "quit"}
  ]
}
