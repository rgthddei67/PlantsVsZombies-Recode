{
  "description": "Flood rescue, full-footprint support, deaths, dry pot grace, save continuity and natural land spawns.",
  "commands": [
    {"op": "goto_level", "level": 101, "resetTestState": true},
    {"op": "choose_cards", "cards": ["PLANT_SUNFLOWER", "PLANT_LILYPAD", "PLANT_FLOWERPOT", "PLANT_WALLNUT", "PLANT_KERNELPULT", "PLANT_COBCANNON", "PLANT_ANCHORLOTUS"]},
    {"op": "wait_state", "state": "GAME", "timeout": 30},
    {"op": "set_spawn_paused", "value": true},
    {"op": "set_sun", "value": 20000},
    {"op": "set_weather", "intensity": "CLEAR", "duration": 600},
    {"op": "set_timescale", "value": 1},
    {"op": "assert_state", "path": "watersideFlood.enabled", "equals": true},
    {"op": "assert_state", "path": "watersideFlood.drowningSeconds", "equals": 15},
    {"op": "set_waterside_water", "value": 0},
    {"op": "plant", "type": "PLANT_SUNFLOWER", "row": 1, "col": 5},
    {"op": "plant", "type": "PLANT_FLOWERPOT", "row": 0, "col": 6},
    {"op": "plant", "type": "PLANT_WALLNUT", "row": 0, "col": 6},
    {"op": "plant", "type": "PLANT_FLOWERPOT", "row": 0, "col": 7},
    {"op": "plant", "type": "PLANT_WALLNUT", "row": 0, "col": 7},
    {"op": "plant", "type": "PLANT_SUNFLOWER", "row": 0, "col": 2},
    {"op": "plant", "type": "PLANT_KERNELPULT", "row": 5, "col": 0},
    {"op": "plant", "type": "PLANT_KERNELPULT", "row": 5, "col": 1},
    {"op": "plant", "type": "PLANT_COBCANNON", "row": 5, "col": 0},
    {"op": "dump_state", "name": "initial.json"},
    {"op": "screenshot", "name": "dry_gauge.png"},
    {"op": "assert_zombie_spawn_row", "type": "ZOMBIE_CATAPULT", "row": 2, "expected": false},
    {"op": "set_waterside_water", "value": 100},
    {"op": "wait_frames", "value": 3},
    {"op": "assert_state", "path": "watersideFlood.floodedCells", "equals": 42},
    {"op": "plant", "type": "PLANT_LILYPAD", "row": 1, "col": 5},
    {"op": "plant", "type": "PLANT_LILYPAD", "row": 0, "col": 6},
    {"op": "plant", "type": "PLANT_LILYPAD", "row": 0, "col": 7},
    {"op": "plant", "type": "PLANT_LILYPAD", "row": 5, "col": 0},
    {"op": "wait_frames", "value": 2},
    {"op": "assert_state", "path": "topPlantsByCell.5_0.watersideHazard", "equals": 1},
    {"op": "plant", "type": "PLANT_LILYPAD", "row": 5, "col": 1},
    {"op": "plant", "type": "PLANT_ANCHORLOTUS", "row": 0, "col": 8},
    {"op": "assert_can_plant", "type": "PLANT_LILYPAD", "row": 0, "col": 8, "expected": false},
    {"op": "wait_seconds", "value": 2},
    {"op": "assert_state", "path": "topPlantsByCell.5_0.watersideHazard", "equals": 0},
    {"op": "assert_state", "path": "cells.0.6.under", "equals": "PLANT_LILYPAD"},
    {"op": "set_timescale", "value": 0},
    {"op": "dump_state", "name": "saved.json"},
    {"op": "save_level_snapshot", "name": "flood"},
    {"op": "reload_level_snapshot", "name": "flood"},
    {"op": "wait_state", "state": "GAME", "timeout": 30},
    {"op": "set_timescale", "value": 0},
    {"op": "dump_state", "name": "restored.json"},
    {"op": "screenshot", "name": "full_flood.png"},
    {"op": "set_spawn_paused", "value": true},
    {"op": "set_timescale", "value": 3},
    {"op": "wait_seconds", "value": 11, "timeout": 15},
    {"op": "assert_state", "path": "topPlantsByCell.0_2.watersideElapsedMs", "atLeast": 13000, "atMost": 14500},
    {"op": "dump_state", "name": "before_deadline.json"},
    {"op": "wait_seconds", "value": 3, "timeout": 10},
    {"op": "dump_state", "name": "drowned.json"},
    {"op": "set_timescale", "value": 1},
    {"op": "damage_plant", "type": "PLANT_FLOWERPOT", "row": 0, "col": 7, "damage": 9999},
    {"op": "set_waterside_water", "value": 0},
    {"op": "wait_frames", "value": 3},
    {"op": "dump_state", "name": "retreated.json"},
    {"op": "screenshot", "name": "retreat_rescue.png"},
    {"op": "assert_can_plant", "type": "PLANT_FLOWERPOT", "row": 0, "col": 6, "expected": false},
    {"op": "assert_state", "path": "cells.0.6.foundation", "equals": "PLANT_FLOWERPOT"},
    {"op": "set_timescale", "value": 3},
    {"op": "wait_seconds", "value": 18, "timeout": 20},
    {"op": "set_timescale", "value": 0},
    {"op": "dump_state", "name": "late_grace_saved.json"},
    {"op": "save_level_snapshot", "name": "late_grace"},
    {"op": "reload_level_snapshot", "name": "late_grace"},
    {"op": "wait_state", "state": "GAME", "timeout": 30},
    {"op": "set_timescale", "value": 0},
    {"op": "dump_state", "name": "late_grace_restored.json"},
    {"op": "set_spawn_paused", "value": true},
    {"op": "set_timescale", "value": 3},
    {"op": "wait_seconds", "value": 3, "timeout": 10},
    {"op": "dump_state", "name": "finished.json"},
    {"op": "set_timescale", "value": 0},
    {"op": "set_waterside_water", "value": 100},
    {"op": "assert_zombie_spawn_row", "type": "ZOMBIE_CATAPULT", "row": 0, "expected": true},
    {"op": "assert_zombie_spawn_row", "type": "ZOMBIE_CATAPULT", "row": 1, "expected": true},
    {"op": "assert_zombie_spawn_row", "type": "ZOMBIE_CATAPULT", "row": 2, "expected": true},
    {"op": "assert_zombie_spawn_row", "type": "ZOMBIE_CATAPULT", "row": 3, "expected": true},
    {"op": "assert_zombie_spawn_row", "type": "ZOMBIE_CATAPULT", "row": 4, "expected": true},
    {"op": "assert_zombie_spawn_row", "type": "ZOMBIE_CATAPULT", "row": 5, "expected": true},
    {"op": "set_wave_spawn_list", "types": ["ZOMBIE_CATAPULT"]},
    {"op": "summon_next_wave", "count": 9, "clearPrevious": true},
    {"op": "wait_frames", "value": 2},
    {"op": "dump_state", "name": "natural.json"},
    {"op": "screenshot", "name": "land_units_in_flood.png"},
    {"op": "set_waterside_water", "value": 0},
    {"op": "assert_zombie_spawn_row", "type": "ZOMBIE_CATAPULT", "row": 2, "expected": false},
    {"op": "quit"}
  ]
}
