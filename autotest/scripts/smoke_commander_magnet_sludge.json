{
  "description": "Compare a live muddy magnet and its expired status against sampled cooldowns.",
  "commands": [
    {"op":"goto_level","level":96,"resetTestState":true},
    {"op":"choose_cards","cards":["PLANT_MAGNETSHROOM"]},
    {"op":"wait_state","state":"GAME","timeout":30},
    {"op":"set_spawn_paused","value":true},
    {"op":"set_weather","intensity":"CLEAR","duration":600},
    {"op":"set_sun","value":9000},
    {"op":"commander_experiment","weights":[4,1.5,148,0.3,3.4,-1,-0.27,1.7],"allZombies":true,"searchVersion":2},
    {"op":"set_cold_storage","state":{"enemyIce":3000,"initialEnemyIce":3000,"playerIce":200,"decisions":20,"decisionRemaining":600}},
    {"op":"spawn_zombie","type":"ZOMBIE_BUCKET","row":3,"x":750,"stationary":true},
    {"op":"plant","type":"PLANT_MAGNETSHROOM","row":2,"col":5},
    {"op":"wait_frames","value":3},
    {"op":"wait_value","path":"normalPlantsByCell.2_5.magnetPhase","timeout":10,"equals":"SUCKING"},
    {"op":"spawn_zombie","type":"ZOMBIE_SLUDGE","row":2,"x":850,"stationary":true},
    {"op":"wait_value","path":"normalPlantsByCell.2_5.sludgeMultiplierOn1000","timeout":10,"equals":500},
    {"op":"kill_zombie","row":2},
    {"op":"set_timescale","value":0},
    {"op":"dump_state","name":"mud_live.json"},
    {"op":"compare_commander_search","name":"mud","budgetsMs":[],"candidatePlans":[{"name":"wait","actions":[]}]},
    {"op":"set_timescale","value":1},
    {"op":"wait_seconds","value":8.3},
    {"op":"set_timescale","value":0},
    {"op":"dump_state","name":"clear_live.json"},
    {"op":"compare_commander_search","name":"clear","budgetsMs":[],"candidatePlans":[{"name":"wait","actions":[]}]},
    {"op":"quit"}
  ]
}
