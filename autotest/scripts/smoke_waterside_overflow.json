{
  "description": "Real rain overflow, capped locked targets, warning save/load, last-minute anchoring and stable identities through retreat.",
  "commands": [
    {"op": "goto_level", "level": 101, "resetTestState": true},
    {"op": "choose_cards", "cards": []},
    {"op": "wait_state", "state": "GAME", "timeout": 30},
    {"op": "set_spawn_paused", "value": true},
    {"op": "set_sun", "value": 20000},
    {"op": "set_weather", "intensity": "CLEAR", "duration": 600},
    {"op": "plant", "type": "PLANT_FLOWERPOT", "row": 0, "col": 4},
    {"op": "plant", "type": "PLANT_SUNFLOWER", "row": 0, "col": 4},
    {"op": "plant", "type": "PLANT_FLOWERPOT", "row": 0, "col": 6},
    {"op": "plant", "type": "PLANT_SUNFLOWER", "row": 0, "col": 6},
    {"op": "set_waterside_water", "value": 100},
    {"op": "plant", "type": "PLANT_LILYPAD", "row": 0, "col": 4},
    {"op": "plant", "type": "PLANT_LILYPAD", "row": 0, "col": 6},
    {"op": "plant", "type": "PLANT_LILYPAD", "row": 0, "col": 7},
    {"op": "plant", "type": "PLANT_SUNFLOWER", "row": 0, "col": 7},
    {"op": "plant", "type": "PLANT_LIGHTNINGRODPOT", "row": 0, "col": 6},
    {"op": "assert_state", "path": "cells.0.6.foundation", "equals": "PLANT_LIGHTNINGRODPOT"},
    {"op": "assert_state", "path": "cells.0.6.lilyAnchored", "equals": true},
    {"op": "assert_state", "path": "cells.0.4.lilyAnchored", "equals": false},
    {"op": "assert_can_plant", "type": "PLANT_FLOWERPOT", "row": 1, "col": 6, "expected": false},
    {"op": "wait_seconds", "value": 0.2},
    {"op": "screenshot", "name": "built.png"},
    {"op": "dump_state", "name": "built.json"},
    {"op": "set_weather", "intensity": "TORRENT", "duration": 600},
    {"op": "set_typhoon", "strength": "NONE", "direction": "NONE"},
    {"op": "set_timescale", "value": 3},
    {"op": "wait_seconds", "value": 10, "timeout": 15},
    {"op": "set_timescale", "value": 0},
    {"op": "screenshot", "name": "overflow_half.png"},
    {"op": "dump_state", "name": "overflow_half.json"},
    {"op": "assert_state", "path": "watersideFlood.overflowMilli", "atLeast": 29000, "atMost": 32000},
    {"op": "set_timescale", "value": 3},
    {"op": "wait_seconds", "value": 10.15, "timeout": 15},
    {"op": "set_timescale", "value": 0},
    {"op": "assert_state", "path": "watersideFlood.surgeTargetCount", "equals": 2},
    {"op": "assert_state", "path": "watersideFlood.surgeCount", "equals": 0},
    {"op": "assert_state", "path": "watersideFlood.warningMs", "atLeast": 4500, "atMost": 5000},
    {"op": "screenshot", "name": "warning_saved.png"},
    {"op": "dump_state", "name": "warning_saved.json"},
    {"op": "save_level_snapshot", "name": "surge_warning"},
    {"op": "reload_level_snapshot", "name": "surge_warning"},
    {"op": "wait_state", "state": "GAME", "timeout": 30},
    {"op": "set_timescale", "value": 0},
    {"op": "set_spawn_paused", "value": true},
    {"op": "screenshot", "name": "warning_restored.png"},
    {"op": "dump_state", "name": "warning_restored.json"},
    {"op": "plant", "type": "PLANT_FLOWERPOT", "row": 0, "col": 7},
    {"op": "assert_state", "path": "cells.0.7.lilyAnchored", "equals": true},
    {"op": "screenshot", "name": "warning_rescued.png"},
    {"op": "dump_state", "name": "warning_rescued.json"},
    {"op": "set_weather", "intensity": "CLEAR", "duration": 600},
    {"op": "set_timescale", "value": 1},
    {"op": "wait_seconds", "value": 5.15, "timeout": 10},
    {"op": "assert_state", "path": "watersideFlood.surgeCount", "equals": 1},
    {"op": "assert_state", "path": "watersideFlood.surgeTargetCount", "equals": 0},
    {"op": "assert_state", "path": "cells.0.4.under", "equals": "NONE"},
    {"op": "assert_state", "path": "cells.0.6.under", "equals": "PLANT_LILYPAD"},
    {"op": "assert_state", "path": "cells.0.6.normal", "equals": "PLANT_SUNFLOWER"},
    {"op": "assert_state", "path": "cells.0.7.under", "equals": "PLANT_LILYPAD"},
    {"op": "assert_state", "path": "cells.0.7.normal", "equals": "PLANT_SUNFLOWER"},
    {"op": "assert_state", "path": "topPlantsByCell.0_4.watersideHazard", "equals": 1},
    {"op": "screenshot", "name": "first_impact.png"},
    {"op": "dump_state", "name": "first_impact.json"},
    {"op": "plant", "type": "PLANT_LILYPAD", "row": 0, "col": 4},
    {"op": "wait_frames", "value": 2},
    {"op": "assert_state", "path": "topPlantsByCell.0_4.watersideHazard", "equals": 0},
    {"op": "set_weather", "intensity": "TORRENT", "duration": 600},
    {"op": "set_typhoon", "strength": "NONE", "direction": "NONE"},
    {"op": "set_timescale", "value": 3},
    {"op": "wait_seconds", "value": 20.15, "timeout": 15},
    {"op": "set_timescale", "value": 0},
    {"op": "assert_state", "path": "watersideFlood.surgeCount", "equals": 1},
    {"op": "assert_state", "path": "watersideFlood.surgeTargetCount", "equals": 1},
    {"op": "screenshot", "name": "second_warning.png"},
    {"op": "dump_state", "name": "second_warning.json"},
    {"op": "damage_plant", "type": "PLANT_LILYPAD", "row": 0, "col": 4, "damage": 9999},
    {"op": "plant", "type": "PLANT_LILYPAD", "row": 0, "col": 4},
    {"op": "screenshot", "name": "replacement.png"},
    {"op": "dump_state", "name": "replacement.json"},
    {"op": "set_weather", "intensity": "CLEAR", "duration": 600},
    {"op": "set_timescale", "value": 1},
    {"op": "wait_seconds", "value": 5.15, "timeout": 10},
    {"op": "assert_state", "path": "watersideFlood.surgeCount", "equals": 2},
    {"op": "assert_state", "path": "cells.0.4.under", "equals": "PLANT_LILYPAD"},
    {"op": "screenshot", "name": "second_impact.png"},
    {"op": "dump_state", "name": "second_impact.json"},
    {"op": "set_timescale", "value": 0},
    {"op": "save_level_snapshot", "name": "surge_finished"},
    {"op": "reload_level_snapshot", "name": "surge_finished"},
    {"op": "wait_state", "state": "GAME", "timeout": 30},
    {"op": "set_timescale", "value": 0},
    {"op": "assert_state", "path": "watersideFlood.surgeCount", "equals": 2},
    {"op": "assert_state", "path": "watersideFlood.surgeTargetCount", "equals": 0},
    {"op": "set_spawn_paused", "value": true},
    {"op": "set_timescale", "value": 1},
    {"op": "set_waterside_water", "value": 0},
    {"op": "wait_seconds", "value": 0.2},
    {"op": "assert_state", "path": "cells.0.4.under", "equals": "NONE"},
    {"op": "assert_state", "path": "cells.0.4.normal", "equals": "PLANT_SUNFLOWER"},
    {"op": "assert_state", "path": "topPlantsByCell.0_4.watersideHazard", "equals": 0},
    {"op": "assert_state", "path": "cells.0.6.under", "equals": "NONE"},
    {"op": "assert_state", "path": "cells.0.6.normal", "equals": "PLANT_SUNFLOWER"},
    {"op": "assert_state", "path": "topPlantsByCell.0_6.watersideHazard", "equals": 0},
    {"op": "assert_state", "path": "cells.0.7.under", "equals": "NONE"},
    {"op": "assert_state", "path": "cells.0.7.normal", "equals": "PLANT_SUNFLOWER"},
    {"op": "assert_state", "path": "topPlantsByCell.0_7.watersideHazard", "equals": 0},
    {"op": "screenshot", "name": "drained.png"},
    {"op": "dump_state", "name": "drained.json"},
    {"op": "quit"}
  ]
}
