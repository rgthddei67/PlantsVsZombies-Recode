{
  "name": "smoke_workshop_pressure_counter",
  "commands": [
    { "op": "wait_frames", "value": 90 },
    { "op": "click", "target": "main_menu_workshop", "hold_frames": 6, "trace": true },
    { "op": "wait_frames", "value": 5 },
    { "op": "assert_state", "path": "workshop.resourcesReady", "equals": true },
    { "op": "workshop_snapshot", "action": "save", "name": "starter" },
    { "op": "workshop_snapshot", "action": "load", "name": "starter", "patch": [
      { "op": "add", "path": "/state/completedWaves", "value": 6 },
      { "op": "add", "path": "/state/energy", "value": 10000 },
      { "op": "replace", "path": "/state/commissions/blueprints/0", "value": true },
      { "op": "add", "path": "/guideSeenWave", "value": 6 }
    ] },
    { "op": "wait_frames", "value": 5 },
    { "op": "assert_state", "path": "workshop.guideTopic", "equals": 43 },
    { "op": "screenshot", "name": "01_commission_guide.png" },
    { "op": "workshop", "action": "guide_close" },
    { "op": "wait_frames", "value": 3 },
    { "op": "workshop", "action": "guide_close" },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "workshop.guideOpen", "equals": false },
    { "op": "workshop", "action": "build", "index": 2, "type": "pressure_grower", "value": 0 },
    { "op": "workshop", "action": "wire_power", "index": 2, "value": 40 },
    { "op": "workshop", "action": "build", "index": 3, "type": "store", "value": 0 },
    { "op": "workshop", "action": "build", "index": 4, "type": "counter", "value": 0 },
    { "op": "workshop", "action": "counter_mode", "index": 4, "value": 1 },
    { "op": "workshop", "action": "setting", "index": 4, "value": 3 },
    { "op": "workshop", "action": "wire_a", "index": 4, "value": 2 },
    { "op": "workshop", "action": "start" },
    { "op": "wait_seconds", "value": 3 },
    { "op": "workshop", "action": "machine_running", "index": 2, "value": 0 },
    { "op": "wait_seconds", "value": 0.3 },
    { "op": "workshop", "action": "pause" },
    { "op": "assert_state", "path": "workshop.cells.2.producedItems.0", "equals": 3 },
    { "op": "assert_state", "path": "workshop.cells.4.count", "equals": 3 },
    { "op": "assert_state", "path": "workshop.cells.4.signal", "equals": true },
    { "op": "workshop", "action": "save" },
    { "op": "workshop", "action": "reload" },
    { "op": "wait_frames", "value": 3 },
    { "op": "assert_state", "path": "workshop.cells.4.inputs.0", "equals": 2 },
    { "op": "assert_state", "path": "workshop.cells.4.count", "equals": 3 },
    { "op": "workshop", "action": "counter_mode", "index": 4, "value": 2 },
    { "op": "workshop", "action": "counter_mode", "index": 4, "value": 1 },
    { "op": "assert_state", "path": "workshop.cells.4.inputs.0", "equals": 2 },
    { "op": "assert_state", "path": "workshop.cells.4.count", "equals": 0 },
    { "op": "workshop", "action": "pause" },
    { "op": "wait_seconds", "value": 0.5 },
    { "op": "workshop", "action": "pause" },
    { "op": "assert_state", "path": "workshop.cells.4.count", "equals": 0 },
    { "op": "dump_state", "name": "pressure_counter.json" },
    { "op": "quit" }
  ]
}
