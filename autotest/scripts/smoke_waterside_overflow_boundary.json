{
  "description": "Light rain crossing 100 conserves excess; clear weather drains overflow before lowering the water surface.",
  "commands": [
    {"op":"goto_level","level":101,"resetTestState":true},
    {"op":"choose_cards","cards":[]},
    {"op":"wait_state","state":"GAME","timeout":30},
    {"op":"set_spawn_paused","value":true},
    {"op":"set_waterside_water","value":99},
    {"op":"set_weather","intensity":"LIGHT","duration":600},
    {"op":"set_timescale","value":3},
    {"op":"wait_seconds","value":10,"timeout":15},
    {"op":"set_timescale","value":0},
    {"op":"assert_state","path":"watersideFlood.waterMilli","equals":100000},
    {"op":"assert_state","path":"watersideFlood.overflowMilli","atLeast":990,"atMost":1020},
    {"op":"assert_state","path":"watersideFlood.surgeCount","equals":0},
    {"op":"dump_state","name":"crossed.json"},
    {"op":"set_weather","intensity":"CLEAR","duration":600},
    {"op":"set_timescale","value":3},
    {"op":"wait_seconds","value":10,"timeout":15},
    {"op":"set_timescale","value":0},
    {"op":"assert_state","path":"watersideFlood.waterMilli","equals":100000},
    {"op":"assert_state","path":"watersideFlood.overflowMilli","atLeast":580,"atMost":620},
    {"op":"dump_state","name":"overflow_drained.json"},
    {"op":"set_timescale","value":3},
    {"op":"wait_seconds","value":20,"timeout":15},
    {"op":"set_timescale","value":0},
    {"op":"assert_state","path":"watersideFlood.overflowMilli","equals":0},
    {"op":"assert_state","path":"watersideFlood.waterMilli","atLeast":99770,"atMost":99820},
    {"op":"dump_state","name":"water_drained.json"},
    {"op":"quit"}
  ]
}
