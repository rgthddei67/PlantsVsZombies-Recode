{
  "description": "Existing fueled lamp is OFF; commander anticipates III edge coverage without mutating it. Actual gear change reveals and defeats the worker without paying to clear fog.",
  "commands": [
    {"op":"goto_level","level":93,"resetTestState":true},
    {"op":"choose_cards","cards":["PLANT_PEASHOOTER","PLANT_PLANTERN"]},
    {"op":"wait_state","state":"GAME","timeout":30},
    {"op":"set_spawn_paused","value":true},
    {"op":"set_sun","value":0},
    {"op":"set_cold_storage","state":{"enemyIce":1000,"playerIce":110,"decisions":10,"decisionRemaining":60}},
    {"op":"station_control","device":1,"value":4},
    {"op":"set_timescale","value":4},
    {"op":"wait_seconds","value":40},
    {"op":"set_timescale","value":1},
    {"op":"plant","type":"PLANT_PEASHOOTER","row":0,"col":0},
    {"op":"plant","type":"PLANT_PEASHOOTER","row":0,"col":1},
    {"op":"plant","type":"PLANT_PEASHOOTER","row":0,"col":2},
    {"op":"plant","type":"PLANT_PEASHOOTER","row":0,"col":3},
    {"op":"plant","type":"PLANT_PLANTERN","row":2,"col":4},
    {"op":"set_plantern_gear","gear":"OFF"},
    {"op":"set_plantern_fuel","value":52},
    {"op":"spawn_zombie","type":"ZOMBIE_ICE_WORKER","row":0,"x":920,"stationary":true},
    {"op":"set_cold_storage","state":{"enemyIce":0,"playerIce":0,"decisionRemaining":60}},
    {"op":"plan_ice_attack","background":true},
    {"op":"await_ice_attack","timeout":30},
    {"op":"dump_state","name":"lamp_response_forecast.json"},
    {"op":"assert_state","path":"coldStorage.searchPlanternResponseGear","equals":3},
    {"op":"assert_state","path":"plantern.gear","equals":"OFF"},
    {"op":"assert_state","path":"plantern.fuelTenths","equals":520},
    {"op":"assert_state","path":"coldStorage.playerIce","equals":0},
    {"op":"set_plantern_gear","gear":"HIGH"},
    {"op":"wait_seconds","value":20,"timeout":30},
    {"op":"assert_state","path":"coldStorage.hostileCount","equals":0},
    {"op":"assert_state","path":"weatherStation.controls.1.value","equals":4},
    {"op":"assert_state","path":"plantern.fuelTenths","atMost":120},
    {"op":"dump_state","name":"lamp_response_actual.json"}
  ]
}
