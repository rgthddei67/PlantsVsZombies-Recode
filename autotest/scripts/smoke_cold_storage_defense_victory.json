{
  "description": "Defense victory: game-time warning, pause/save continuity, troop-only reset and withdrawal with live/paid/precision transactions. Clock setup is a boundary fixture, not strength evidence.",
  "muteAudio": true,
  "commands": [
    {"op":"set_fullscreen","value":false},
    {"op":"goto_level","level":92,"resetTestState":true,"coldStorageBonusSelection":false},
    {"op":"choose_cards","cards":["PLANT_PEASHOOTER"]},
    {"op":"wait_state","state":"GAME","timeout":30},
    {"op":"set_spawn_paused","value":true},
    {"op":"set_cold_storage","state":{"enemyIce":2602,"decisions":21,"decisionRemaining":60,"troopNoKillSeconds":299.5}},
    {"op":"wait_seconds","value":1},
    {"op":"assert_state","path":"coldStorage.troopNoKillSeconds","equals":299.5},
    {"op":"assert_state","path":"coldStorage.finalAssaultActive","equals":false},
    {"op":"set_spawn_paused","value":false},
    {"op":"wait_seconds","value":1},
    {"op":"assert_state","path":"coldStorage.finalAssaultActive","equals":true},
    {"op":"screenshot","name":"last_assault.png"},
    {"op":"key","name":"space"},
    {"op":"wait_frames","value":2},
    {"op":"assert_state","path":"paused","equals":true},
    {"op":"dump_state","name":"pause_before.json"},
    {"op":"wait_frames","value":60},
    {"op":"dump_state","name":"pause_after.json"},
    {"op":"key","name":"space"},
    {"op":"wait_frames","value":2},
    {"op":"save_level_snapshot","name":"countdown"},
    {"op":"dump_state","name":"before_reload.json"},
    {"op":"reload_level_snapshot","name":"countdown"},
    {"op":"wait_state","state":"GAME","timeout":30},
    {"op":"assert_state","path":"coldStorage.finalAssaultActive","equals":true},
    {"op":"dump_state","name":"after_reload.json"},
    {"op":"plant","type":"PLANT_PEASHOOTER","row":4,"col":0},
    {"op":"set_cold_storage","state":{"troopNoKillSeconds":320,"strikeCooldownRemaining":0,"decisionRemaining":60}},
    {"op":"start_precision_strike","row":4,"col":0},
    {"op":"wait_seconds","value":9,"timeout":20},
    {"op":"assert_state","path":"coldStorage.troopPlantKills","equals":0},
    {"op":"assert_state","path":"coldStorage.troopNoKillSeconds","atLeast":328.5},
    {"op":"assert_state","path":"coldStorage.killIncome","atLeast":1},
    {"op":"plant","type":"PLANT_PEASHOOTER","row":0,"col":0},
    {"op":"kill_plant_by_zombie","row":0,"col":0},
    {"op":"assert_state","path":"coldStorage.troopPlantKills","equals":1},
    {"op":"assert_state","path":"coldStorage.troopNoKillSeconds","atMost":1},
    {"op":"assert_state","path":"coldStorage.finalAssaultActive","equals":false},
    {"op":"set_cold_storage","state":{"troopNoKillSeconds":330,"decisionRemaining":60}},
    {"op":"queue_ice_zombie","type":"ZOMBIE_ICE_WORKER","row":2,"delay":0},
    {"op":"wait_seconds","value":6,"timeout":15},
    {"op":"assert_state","path":"coldStorage.workerIncome","atLeast":4},
    {"op":"assert_state","path":"coldStorage.troopNoKillSeconds","atLeast":335.5},
    {"op":"plant","type":"PLANT_PEASHOOTER","row":4,"col":1},
    {"op":"set_cold_storage","state":{"troopNoKillSeconds":359,"strikeCooldownRemaining":0,"decisionRemaining":60}},
    {"op":"start_precision_strike","row":4,"col":1},
    {"op":"queue_ice_zombie","type":"ZOMBIE_BUCKET","row":1,"delay":30},
    {"op":"dump_state","name":"before_surrender.json"},
    {"op":"wait_value","path":"coldStorage.trophySpawned","equals":true,"timeout":10},
    {"op":"assert_state","path":"coldStorage.defenseSurrendered","equals":true},
    {"op":"assert_state","path":"coldStorage.hostileCount","equals":0},
    {"op":"assert_state","path":"coldStorage.pending","equals":[]},
    {"op":"assert_state","path":"coldStorage.strikeTargetID","equals":-1},
    {"op":"assert_state","path":"coldStorage.playerKillIncome","equals":0},
    {"op":"dump_state","name":"surrender.json"},
    {"op":"wait_frames","value":60},
    {"op":"assert_state","path":"coldStorage.hostileCount","equals":0},
    {"op":"screenshot","name":"defense_success.png"},
    {"op":"click","target":"trophy"},
    {"op":"wait_state","state":"WIN","timeout":10},
    {"op":"quit"}
  ]
}
