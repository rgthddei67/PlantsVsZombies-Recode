{
  "commands": [
    {"op": "goto_level", "level": 71, "background": "POLAR_NIGHT_SNOWFIELD", "resetTestState": true},
    {"op": "choose_cards", "cards": ["PLANT_DAWNLOTUS"], "timeout": 20},
    {"op": "wait_state", "state": "GAME", "timeout": 20},
    {"op": "set_spawn_paused", "value": true},
    {"op": "set_timescale", "value": 5},
    {"op": "set_polar_environment", "temperature": -22, "humidity": 58, "wind": 8, "direction": "NONE", "phase": "DANGER_HOLD", "remaining": 60},
    {"op": "plant", "type": "PLANT_DAWNLOTUS", "row": 2, "col": 2},
    {"op": "assert_state", "path": "area8FinaleResources.dawnStrikeTexturesLoaded", "equals": true},
    {"op": "wait_seconds", "value": 17.4, "timeout": 10},
    {"op": "set_timescale", "value": 1},
    {"op": "spawn_zombie", "type": "ZOMBIE_GARGANTUAR", "row": 1, "x": 760, "stationary": true},
    {"op": "spawn_zombie", "type": "ZOMBIE_BUCKET", "row": 1, "x": 680, "stationary": true},
    {"op": "spawn_zombie", "type": "ZOMBIE_FOOTBALL", "row": 2, "x": 840, "stationary": true},
    {"op": "spawn_zombie", "type": "ZOMBIE_AURORA_PRIEST", "row": 3, "x": 730, "stationary": true},
    {"op": "assert_state", "path": "particleEffectNameCounts.DawnLotusStrike", "equals": 0},
    {"op": "dump_state", "name": "before_strike.json"},
    {"op": "activate_dawn_lotus", "row": 2, "col": 2},
    {"op": "assert_state", "path": "particleEffectNameCounts.DawnLotusStrike", "equals": 3},
    {"op": "assert_state", "path": "zombiesByType.ZOMBIE_GARGANTUAR.bodyHealth", "equals": 1600},
    {"op": "assert_state", "path": "zombiesByType.ZOMBIE_BUCKET.helmHealth", "equals": 800},
    {"op": "assert_state", "path": "zombiesByType.ZOMBIE_AURORA_PRIEST.bodyHealth", "equals": 600},
    {"op": "wait_frames", "value": 8},
    {"op": "screenshot", "name": "strike_impact.png"},
    {"op": "assert_state", "path": "particleEffectsByName.DawnLotusStrike.0.renderProbeReady", "equals": true},
    {"op": "assert_state", "path": "particleEffectsByName.DawnLotusStrike.0.renderQuadCount", "atLeast": 30},
    {"op": "assert_state", "path": "particleEffectsByName.DawnLotusStrike.0.worldBounds.widthInt", "atLeast": 60},
    {"op": "assert_state", "path": "particleEffectsByName.DawnLotusStrike.0.worldBounds.heightInt", "atLeast": 140},
    {"op": "assert_state", "path": "particleEffectsByName.DawnLotusStrike.0.nearestZombie.row", "equals": 1},
    {"op": "assert_state", "path": "particleEffectsByName.DawnLotusStrike.0.nearestZombie.boundsIntersect", "equals": true},
    {"op": "assert_state", "path": "particleEffectsByName.DawnLotusStrike.1.renderProbeReady", "equals": true},
    {"op": "assert_state", "path": "particleEffectsByName.DawnLotusStrike.1.renderQuadCount", "atLeast": 30},
    {"op": "assert_state", "path": "particleEffectsByName.DawnLotusStrike.1.worldBounds.widthInt", "atLeast": 60},
    {"op": "assert_state", "path": "particleEffectsByName.DawnLotusStrike.1.worldBounds.heightInt", "atLeast": 140},
    {"op": "assert_state", "path": "particleEffectsByName.DawnLotusStrike.1.nearestZombie.row", "equals": 2},
    {"op": "assert_state", "path": "particleEffectsByName.DawnLotusStrike.1.nearestZombie.boundsIntersect", "equals": true},
    {"op": "assert_state", "path": "particleEffectsByName.DawnLotusStrike.2.renderProbeReady", "equals": true},
    {"op": "assert_state", "path": "particleEffectsByName.DawnLotusStrike.2.renderQuadCount", "atLeast": 30},
    {"op": "assert_state", "path": "particleEffectsByName.DawnLotusStrike.2.worldBounds.widthInt", "atLeast": 60},
    {"op": "assert_state", "path": "particleEffectsByName.DawnLotusStrike.2.worldBounds.heightInt", "atLeast": 140},
    {"op": "assert_state", "path": "particleEffectsByName.DawnLotusStrike.2.nearestZombie.row", "equals": 3},
    {"op": "assert_state", "path": "particleEffectsByName.DawnLotusStrike.2.nearestZombie.boundsIntersect", "equals": true},
    {"op": "dump_state", "name": "strike_impact.json"},
    {"op": "wait_seconds", "value": 0.32, "timeout": 3},
    {"op": "screenshot", "name": "strike_scatter.png"},
    {"op": "dump_state", "name": "strike_scatter.json"},
    {"op": "wait_seconds", "value": 1.2, "timeout": 4},
    {"op": "assert_state", "path": "particleEffectNameCounts.DawnLotusStrike", "equals": 0},
    {"op": "dump_state", "name": "strike_finished.json"}
  ]
}
