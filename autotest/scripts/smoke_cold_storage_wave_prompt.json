{
  "commands": [
    {"op":"reset_test_state"},
    {"op":"commander_experiment","weights":[0,0,0,0,0,1,0,0],"searchVersion":1},
    {"op":"goto_level","level":82},
    {"op":"choose_cards","cards":["PLANT_SUNFLOWER"]},
    {"op":"wait_state","state":"GAME","timeout":25},
    {"op":"set_spawn_paused","value":true},
    {"op":"set_cold_storage","state":{"enemyIce":119,"initialEnemyIce":119,"decisions":20,"decisionRemaining":60}},
    {"op":"plan_ice_attack"},
    {"op":"dump_state","name":"below_threshold.json"},
    {"op":"assert_state","path":"coldStorage.commanderSpent","atLeast":1,"atMost":119},
    {"op":"assert_state","path":"prompts.activeCount","equals":0},
    {"op":"set_cold_storage","state":{"enemyIce":120,"pending":[]}},
    {"op":"plan_ice_attack"},
    {"op":"dump_state","name":"threshold.json"},
    {"op":"assert_state","path":"coldStorage.commanderSpent","equals":120},
    {"op":"assert_state","path":"prompts.activeCount","equals":1},
    {"op":"assert_state","path":"prompts.entries.0.content","equals":"IMAGE_APPROACHING"},
    {"op":"wait_seconds","value":1,"timeout":5},
    {"op":"screenshot","name":"huge_wave.png"},
    {"op":"set_cold_storage","state":{"enemyIce":120}},
    {"op":"plan_ice_attack","background":true},
    {"op":"await_ice_attack","timeout":30},
    {"op":"dump_state","name":"overlapping.json"},
    {"op":"assert_state","path":"coldStorage.commanderSpent","equals":120},
    {"op":"assert_state","path":"prompts.activeCount","equals":2},
    {"op":"assert_state","path":"prompts.entries.1.content","equals":"IMAGE_APPROACHING"},
    {"op":"wait_seconds","value":0.5,"timeout":5},
    {"op":"screenshot","name":"overlapping.png"},
    {"op":"commander_experiment","weights":[0,0,0,0,0,-1,0,0],"searchVersion":1},
    {"op":"plan_ice_attack"},
    {"op":"assert_state","path":"coldStorage.commanderSpent","equals":0},
    {"op":"assert_state","path":"prompts.activeCount","equals":2},
    {"op":"wait_seconds","value":3.5,"timeout":8},
    {"op":"assert_state","path":"prompts.activeCount","equals":1},
    {"op":"wait_seconds","value":1.5,"timeout":5},
    {"op":"assert_state","path":"prompts.activeCount","equals":0},
    {"op":"quit"}
  ]
}
