{
  "name": "smoke_minigame_brawl",
  "commands": [
    {"op":"wait_frames","value":120},
    {"op":"set_adventure_level","level":1},
    {"op":"click","target":"main_menu_minigames","hold_frames":6},
    {"op":"wait_frames","value":60},
    {"op":"assert_state","path":"gameSelectMode","equals":"MINIGAMES"},
    {"op":"assert_state","path":"gameSelectAvailableLevels","equals":[2000,2001]},
    {"op":"assert_state","path":"gameSelectCreatedCardCount","equals":2},
    {"op":"screenshot","name":"01_select.png"},
    {"op":"click","target":"game_select_level","level":2001,"hold_frames":6},
    {"op":"wait_state","state":"CHOOSE_CARD","timeout":30},
    {"op":"assert_state","path":"level","equals":2001},
    {"op":"assert_state","path":"levelName","equals":"小游戏：大混战"},
    {"op":"assert_state","path":"background","equals":"HOT_COLD_STORAGE"},
    {"op":"assert_state","path":"sun","equals":3000},
    {"op":"assert_state","path":"maxWave","equals":0},
    {"op":"assert_state","path":"coldStorage.initialEnemyIce","equals":850},
    {"op":"assert_state","path":"coldStorage.enemyIce","equals":850},
    {"op":"assert_state","path":"spawnTypeCount","atLeast":40},
    {"op":"assert_state","path":"spawnListHasBobsledTeam","equals":true},
    {"op":"assert_state","path":"spawnListHasGildedZamboni","equals":true},
    {"op":"dump_state","name":"opening.json"},
    {"op":"wait_value","path":"chooseCardReady","equals":true,"timeout":30},
    {"op":"wait_frames","value":5},
    {"op":"assert_state","path":"chooseCardPageCount","equals":2},
    {"op":"assert_state","path":"chooseCardVisibleCardCount","equals":48},
    {"op":"assert_state","path":"haveCardCount","equals":1},
    {"op":"screenshot","name":"02_cards.png"},
    {"op":"choose_cards","cards":["PLANT_PEASHOOTER","PLANT_SUNFLOWER","PLANT_WALLNUT","PLANT_POTATOMINE","PLANT_CHERRYBOMB","PLANT_PUFFSHROOM","PLANT_INSTANT_COFFEE"]},
    {"op":"wait_state","state":"GAME","timeout":30},
    {"op":"set_spawn_paused","value":true},
    {"op":"queue_ice_zombie","type":"ZOMBIE_REDEYE_GARGANTUAR","row":0},
    {"op":"queue_ice_zombie","type":"ZOMBIE_DOLPHIN_RIDER","row":0,"expectedSuccess":false},
    {"op":"assert_state","path":"coldStorage.enemyIce","equals":826},
    {"op":"assert_state","path":"coldStorage.pendingCount","equals":1},
    {"op":"save_level_snapshot","name":"brawl_pending"},
    {"op":"reload_level_snapshot","name":"brawl_pending"},
    {"op":"assert_state","path":"coldStorage.initialEnemyIce","equals":850},
    {"op":"assert_state","path":"coldStorage.enemyIce","equals":826},
    {"op":"assert_state","path":"coldStorage.pendingCount","equals":1},
    {"op":"set_spawn_paused","value":false},
    {"op":"wait_seconds","value":3},
    {"op":"assert_state","path":"coldStorage.deployments","atLeast":1},
    {"op":"plan_ice_attack"},
    {"op":"assert_state","path":"coldStorage.searchSerial","atLeast":1},
    {"op":"assert_state","path":"coldStorage.candidatesEvaluated","atLeast":1},
    {"op":"dump_state","name":"ai_decision.json"},
    {"op":"screenshot","name":"03_battle.png"},
    {"op":"quit"}
  ]
}
