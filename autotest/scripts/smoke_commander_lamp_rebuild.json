{
  "description": "Missing lamp can be legally rebuilt and switched up; forecast preserves real wallet and board, actual paid planting restores targeting.",
  "commands": [
    {"op":"goto_level","level":93,"resetTestState":true},
    {"op":"choose_cards","cards":["PLANT_PEASHOOTER","PLANT_PLANTERN"]},
    {"op":"wait_state","state":"GAME","timeout":30},
    {"op":"set_spawn_paused","value":true},
    {"op":"set_sun","value":0},
    {"op":"set_cold_storage","state":{"enemyIce":1000,"playerIce":200,"decisions":10,"decisionRemaining":60}},
    {"op":"station_control","device":1,"value":4},
    {"op":"set_timescale","value":4},
    {"op":"wait_seconds","value":40},
    {"op":"set_timescale","value":1},
    {"op":"plant","type":"PLANT_PEASHOOTER","row":0,"col":0},
    {"op":"plant","type":"PLANT_PEASHOOTER","row":0,"col":1},
    {"op":"plant","type":"PLANT_PEASHOOTER","row":0,"col":2},
    {"op":"plant","type":"PLANT_PEASHOOTER","row":0,"col":3},
    {"op":"plant","type":"PLANT_PEASHOOTER","row":0,"col":4},
    {"op":"plant","type":"PLANT_PEASHOOTER","row":0,"col":5},
    {"op":"spawn_zombie","type":"ZOMBIE_ICE_WORKER","row":0,"x":920,"stationary":true},
    {"op":"set_sun","value":25},
    {"op":"set_cold_storage","state":{"enemyIce":0,"playerIce":10,"decisionRemaining":60}},
    {"op":"plan_ice_attack","background":true},
    {"op":"await_ice_attack","timeout":30},
    {"op":"dump_state","name":"rebuild_forecast.json"},
    {"op":"assert_state","path":"coldStorage.searchPredictedPlantings","equals":1},
    {"op":"assert_state","path":"coldStorage.searchRawProduction","atMost":10},
    {"op":"assert_state","path":"coldStorage.searchFogCounters","equals":0},
    {"op":"assert_state","path":"plantern.active","equals":false},
    {"op":"assert_state","path":"coldStorage.playerIce","equals":10},
    {"op":"assert_state","path":"sun","equals":25},
    {"op":"player_plant","slot":1,"row":2,"col":4},
    {"op":"assert_state","path":"plantern.active","equals":true},
    {"op":"assert_state","path":"coldStorage.playerIce","equals":0},
    {"op":"assert_state","path":"sun","equals":0},
    {"op":"set_plantern_gear","gear":"HIGH"},
    {"op":"wait_seconds","value":10,"timeout":20},
    {"op":"assert_state","path":"coldStorage.hostileCount","equals":0},
    {"op":"assert_state","path":"weatherStation.controls.1.value","equals":4},
    {"op":"dump_state","name":"rebuild_actual.json"}
  ]
}
