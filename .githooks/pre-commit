#!/bin/bash
# 新头文件严格遵循首行 #pragma once；既有文件保留旧守卫兼容检查。
# 读取暂存 blob，避免工作树中尚未暂存的修复掩盖坏提交。Git for Windows 自带 Bash/awk。
# CMake configure 通过 core.hooksPath .githooks 启用本钩子。
set -o pipefail

# 禁用改名检测，使新路径也接受新增检查；NUL 分隔保留空格、中文等文件名。
git diff --cached --name-status --no-renames -z --diff-filter=AM -- '*.h' '*.hpp' '*.hh' '*.hxx' |
{
    fail=0
    while IFS= read -r -d '' status && IFS= read -r -d '' path; do
        if ! git show ":$path" | LC_ALL=C awk -v status="$status" '
            NR == 1 { first = $0; sub(/\r$/, "", first) }
            length(prefix) < 512 { prefix = prefix substr($0 "\n", 1, 512 - length(prefix)) }
            END {
                # 读完输入再退出，避免大头文件让 git show 收到 SIGPIPE。
                if (status == "A")
                    exit !(first ~ /^#pragma[ \t]+once([ \t]*(\/\/.*)?)?$/)
                exit !(prefix ~ /#pragma once|#ifndef/)
            }
        '; then
            if [ "$status" = A ]; then
                printf '新增头文件首行须为 #pragma once（UTF-8 无 BOM）：%s\n' "$path"
            else
                printf '既有头文件缺少守卫（#pragma once / #ifndef）：%s\n' "$path"
            fi
            fail=1
        fi
    done
    if [ "$fail" -ne 0 ]; then
        printf '提交被拦截，请修正上述文件的暂存内容。\n'
    fi
    exit "$fail"
}
